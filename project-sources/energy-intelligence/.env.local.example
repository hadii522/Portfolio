# Optional overrides. Copy this file to .env.local; do not commit credentials.
# Portable PostgreSQL is configured automatically when ETIP_DATABASE_URL is absent.
# ETIP_DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/etip
# ETIP_API_ORIGIN=http://127.0.0.1:8000
# Optional: enables grounded LLM synthesis; deterministic briefs work without a key.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ETIP_LLM_MODEL=llama-3.3-70b-versatile
